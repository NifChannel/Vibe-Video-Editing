{
  "schema_version": 1,
  "default_choice": "auto",
  "base_model": "Qwen3-ASR-1.7B",
  "aligner_model": "Qwen3-ForcedAligner-0.6B",
  "universal_quality_reference": "references/speech-f-workflow.md",
  "styles": {
    "auto": {
      "label": "自动",
      "description": "无口播跳过；有口播优先按本次要求、选择或样片处理，否则使用默认方案。",
      "effective_when_speech_present": "default"
    },
    "default": {
      "label": "默认风格",
      "description": "无口播样片和明确口播要求时，采用连贯、清晰且有自然分句与转折的默认节奏。",
      "application_conditions": {
        "speech_present": "yes",
        "reference_present": "no",
        "speech_brief_empty": true,
        "eligible_choices": [
          "auto",
          "default"
        ]
      },
      "timing_policy": "保留完整流畅表达，清理废弃重录、误起和无意义重复；按分句、完整句间、主题转换分别审查保留语流中的停顿。",
      "pause_targets_seconds": {
        "clause_or_list": {
          "target": 0.25,
          "range": [
            0.2,
            0.4
          ]
        },
        "sentence": {
          "target": 0.8,
          "range": [
            0.6,
            1.1
          ]
        },
        "concept": {
          "target": 2.2,
          "range": [
            1.9,
            2.6
          ]
        }
      },
      "over_range_policy": "逐处审查超过常用范围的停顿，确认冗余且有字音安全余量后收紧。",
      "short_natural_gap_policy": "保留自然流畅的短衔接，不为满足范围下限而补静音。",
      "semantic_exceptions": [
        "强调",
        "设问",
        "包袱",
        "理解停顿"
      ],
      "targets_are_not_mandatory_durations": true,
      "protect_word_edges_and_necessary_breaths": true,
      "breath_policy": "将停顿时长和其中声音分开判断；处理突出呼吸与口腔杂声，保留必要换气，按实际录音确定处理方式和幅度。",
      "execution_policy": "检查保留语流内部的气口和衔接，逐处形成保留或收紧理由；清掉重录本身不等于已应用默认节奏。",
      "whole_track_speedup": false,
      "inherit_visual_style": false
    },
    "compact": {
      "label": "紧凑口播",
      "description": "自媒体、时效新闻，衔接更紧。",
      "evidence_status": "reference_policy_requires_project_calibration",
      "basis_reference": "references/speech-f-workflow.md",
      "timing_policy": "在同等质量保护下更积极收紧句内多余等待和误起；语义边界利落衔接，句间只收明确拖沓，保留观点、数字与转折的必要停顿。",
      "within_clause_redundant_gap_reference_seconds": [
        0.08,
        0.15
      ],
      "sentence_pause_policy": "preserve_meaningful_not_uniformly_compress",
      "inherit_visual_style": false,
      "whole_track_speedup": false,
      "future_material_calibration_required": true
    },
    "relaxed": {
      "label": "舒缓口播",
      "description": "讲座、课程，保留理解停顿。",
      "evidence_status": "reference_policy_requires_project_calibration",
      "timing_policy": "保留课堂分句、列举和理解停顿；积极处理废弃起音和突出换气，但不剪成连珠炮。",
      "calibrated_reference_targets_seconds": {
        "within_clause": 0.24,
        "clause_or_list": 0.4,
        "sentence": 0.6,
        "concept": 0.85,
        "unanchored_long_pause": 0.7
      },
      "targets_are_not_mandatory_durations": true,
      "whole_track_speedup": false,
      "future_material_calibration_required": true
    }
  }
}
